    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst simplified = items.map((it, idx) => {\n  const products = (it.json.result?.structuredContent?.products || []).slice(0, 8).map(p => ({\n    name: p.displayName,\n    isPromoted: p.isPromoted || false,\n    variants: (p.variations || []).map(v => ({\n      spinId: v.spinId,\n      size: v.quantityDescription,\n      price: v.price?.offerPrice,\n      inStock: v.isInStockAndAvailable\n    }))\n  }));\n  return { searchIndex: idx, products };\n});\nreturn [{ json: { searchResults: simplified } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1904,
        176
      ],
      "id": "1c8cd45c-f15e-4881-b11c-64e845b0cdba",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "// Parse the LLM's selected items\nconst raw = ($input.first().json.choices?.[0]?.message?.content || \"\").trim();\nif (!raw) { throw new Error(\"Selection LLM returned empty content.\"); }\nlet items;\ntry { items = JSON.parse(raw); }\ncatch (e) { throw new Error(\"Selection returned invalid JSON: \" + raw.slice(0, 200)); }\n\n// Get what the user originally requested\nconst requested = $('Code in JavaScript1').all().map(i => i.json);\n\n// Find requested items that did NOT make it into the cart\nconst selectedNames = items.map(i => (i.name || \"\").toLowerCase());\nconst missing = requested\n  .filter(r => {\n    const reqItem = (r.item || \"\").toLowerCase();\n    return !selectedNames.some(sn => sn.includes(reqItem) || reqItem.includes(sn.split(\" \")[0]));\n  })\n  .map(r => r.item);\n\nreturn [{ json: { items, missing } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2256,
        256
      ],
      "id": "be154f7f-9365-4a12-8252-f2e6854f8b0e",
      "name": "Code in JavaScript3"
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ ($('Code in JavaScript3').first().json.items.length > 0 ? \"\u2705 Added to your Swiggy Instamart cart:\\n\\n\" + $('Code in JavaScript3').first().json.items.map(i => \"\u2022 \" + i.quantity + \"\u00d7 \" + i.name).join(\"\\n\") : \"\ud83d\uded2 Nothing could be added to your cart.\") + ($('Code in JavaScript3').first().json.missing.length > 0 ? \"\\n\\n\u26a0\ufe0f Couldn't find: \" + $('Code in JavaScript3').first().json.missing.join(\", \") : \"\") + \"\\n\\n\ud83d\uded2 [Open Instamart cart](https://www.swiggy.com/instamart) to review & checkout.\" }}",
