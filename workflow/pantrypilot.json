    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.choices?.[0]?.message?.content || \"\").trim();\nlet items = [];\ntry { items = JSON.parse(raw); } catch (e) { items = []; }\n\n// If empty (gibberish/non-grocery), emit a single marker item so the flow continues to the IF check\nif (!Array.isArray(items) || items.length === 0) {\n  return [{ json: { _empty: true } }];\n}\n\n// Normal case: one item per grocery item, each flagged not-empty\nreturn items.map(it => ({ json: { ...it, _empty: false } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        400
      ],
      "id": "9dc2e690-3456-419b-9507-270d2d35caec",
