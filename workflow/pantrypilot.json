        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: \"2.0\", id: 1, method: \"tools/call\", params: { name: \"update_cart\", arguments: { selectedAddressId: \"YOUR_SWIGGY_ADDRESS_ID\", items: $json.items } } }) }}",
        "options": {}
