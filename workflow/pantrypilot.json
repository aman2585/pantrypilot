    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"qwen/qwen3.6-27b\",\n  reasoning_effort: \"none\",\n  messages: [\n    { role: \"system\", content: \"You are a grocery cart builder. Input: the user's requested items (with quantities) and search results for each item in the SAME order. For EACH requested item, pick ONE best product variant. RULES: (1) Skip any product with isPromoted true. (2) Prefer a standard single pack, not bulk/multipacks. (3) Only inStock variants. (4) If a search result is empty, omit that item. Output ONLY a compact JSON array, no explanation. Format: [{\\\"spinId\\\":\\\"X\\\",\\\"name\\\":\\\"product name\\\",\\\"quantity\\\":N}]\" },\n    { role: \"user\", content: \"Requested items: \" + JSON.stringify($('Code in JavaScript1').all().map(i => i.json)) + \"\\n\\nSearch results (same order): \" + JSON.stringify($json.searchResults) }\n  ],\n  max_tokens: 800,\n  temperature: 0\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2064,
        -128
      ],
