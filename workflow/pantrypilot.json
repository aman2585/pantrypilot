    {
      "parameters": {
        "method": "POST",
        "url": "https://mcp.swiggy.com/im",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SWIGGY_MCP_TOKEN"
