        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: \"2.0\", id: 1, method: \"tools/call\", params: { name: \"search_products\", arguments: { addressId: \"YOUR_SWIGGY_ADDRESS_ID\", query: $json.item } } }) }}",
        "options": {}
