    {
      "parameters": {
        "jsCode": "const result = $input.first().json.result || [];\nif (result.length === 0) { return []; }\nconst latest = result[result.length - 1];\nconst latestId = latest.update_id;\n\nconst token = \"YOUR_TELEGRAM_BOT_TOKEN\";\nlet ackStatus = \"not attempted\";\ntry {\n  const resp = await fetch(`https://api.telegram.org/bot${token}/getUpdates?offset=${latestId + 1}`);\n  ackStatus = \"ack sent, status \" + resp.status;\n} catch (e) {\n  ackStatus = \"ack FAILED: \" + e.message;\n}\n\nreturn [{ json: { ackStatus, latestId, passedThrough: true } }];"
      },
