            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"openai/gpt-oss-20b\",\n  reasoning_effort: \"low\",\n  messages: [\n    { role: \"system\", content: \"You are a multilingual grocery parser. The user may speak in English, Hindi, Hinglish (Hindi-English mix), or any Indian language, via voice or text. Extract the shopping items and return ONLY a JSON array, no other text. Each element: {\\\"item\\\": string, \\\"qty\\\": number, \\\"unit\\\": string}. IMPORTANT: always translate the item name to its common ENGLISH grocery term (e.g. doodh\u2192milk, chawal\u2192rice, cheeni\u2192sugar, atta\u2192flour, anda\u2192eggs, dahi\u2192curd, pyaaz\u2192onion). If quantity or unit is unclear, use qty 1 and unit \\\"unit\\\". Example: input 'do packet doodh aur ek bread' \u2192 [{\\\"item\\\":\\\"milk\\\",\\\"qty\\\":2,\\\"unit\\\":\\\"packet\\\"},{\\\"item\\\":\\\"bread\\\",\\\"qty\\\":1,\\\"unit\\\":\\\"unit\\\"}]\" },\n    { role: \"user\", content: $json.text }\n  ],\n  max_tokens: 500,\n  temperature: 0\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        960,
        0
      ],
      "id": "4358152b-9061-4f15-893a-c5484b893979",
